text = "اهلين فييييك بلعبتي تبع الالغاز انت حاليا انت كنت ببيتك وفجأة فقت هون انت هلق
 باول غرفة لازم تكفي الدرج الي مصنوع من الصناديق التحكم عادي ببين معك بالزرار الموجودة
بالتوفيق يا عزيزي❤️"

[node name="Label3D2" type="Label3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -9.851883, 10.345767, -23.887182)
text = "اهلين فيك للمرة الثانية التحكم كتييييير سهل w a s d ولحتى تطير 
لفوق اضغط space  ولحتى تنزل اضغط shift ولحتى تمسك الصناديق 
اضغط E ولحتى ترجع لاعب اضغط T
ملاحظة مهمة:لما بدك تمسك الصندوق وبدك تفلتو اضغط E لأن اذا 
ما ضغطو وطلعت من الدرون رح تضطر تعيد اللعبة لأن ما فيك نرجع
درون
بالتوفيق مرة تانية❤️"

